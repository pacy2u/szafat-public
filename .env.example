# Database
DATABASE_URL=postgresql://user:password@localhost:5432/szafat

# Auth.js
AUTH_SECRET=change-me-to-a-random-32-char-string
AUTH_URL=http://localhost:3000

# S3-compatible storage (Cloudflare R2 or AWS S3)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=szafat-photos
S3_PUBLIC_URL=https://photos.yourdomain.com

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_MAILTO=mailto:admin@yourdomain.com
